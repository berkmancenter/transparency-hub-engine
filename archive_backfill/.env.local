# Do Not Put Sensitive Information Here
# Use a real .env file in this directory instead (see archive_backfill/settings.py --
# it loads archive_backfill/.env first, then falls back to the repo root's .env
# for anything not set here, e.g. MONGODB_URL can be shared with the live pipeline).
#
# IMPORTANT: this fallback is why every var name below that's also read by
# the live pipeline (MONGODB_URL, GCP_BUCKET, GCLOUD_PROJECT, CAPTURES_DIR,
# SLACK_WEBHOOK_URL) is fine to leave unset here and inherit from the repo
# root's .env -- but a var name that means something DIFFERENT per job must
# never collide. BACKFILL_CONFIG_PATH exists (instead of reusing the root's
# own CONFIG_PATH) specifically to avoid that: if this job fell back to the
# root .env's CONFIG_PATH, it would silently load the LIVE PIPELINE's
# config.yaml instead of its own -- which has no MAIN_DB_NAME key, so
# MAIN_DB_NAME would silently default to "dev_db" and this job would query
# an empty database instead of the real one. (This actually happened during
# development -- see git history / the mark_precaptured.py rollout.)

# Run in dry-run mode: discovers and fetches as normal but never writes to
# Mongo or GCS, only logs what would happen. Always forced to false when
# running on Cloud Run (CLOUD_RUN_EXECUTION is set).
# Defaults to false
DRY_RUN='false'

# Path to this job's config.yaml (tunables like rate limits, retry counts,
# batch/time budgets, year range -- see archive_backfill/config.yaml).
# Deliberately NOT named CONFIG_PATH -- see note above.
# Defaults to archive_backfill/config.yaml
BACKFILL_CONFIG_PATH='archive_backfill/config.yaml'

# Same Mongo Atlas connection string the live pipeline uses -- this job
# reads "companies" and writes "documents_v2" in the same database
# (MAIN_DB_NAME in config.yaml), and uses a separate database on the same
# cluster (BACKFILL_DB_NAME in config.yaml) for its own progress tracking.
# To run locally, use mongodb://localhost:27017/
MONGODB_URL='mongodb://localhost:27017/'

# Name of the Google Cloud Platform bucket documents are stored in -- must
# be the SAME bucket the live pipeline uses (GCP_BUCKET in the repo root's
# .env), since backfilled captures are written into the same documents_v2
# collection/bucket layout as live crawls.
GCP_BUCKET='your_document_store'
GCLOUD_PROJECT='my-project-1234'

# Root of the GCS FUSE mount when running on Cloud Run. Only used when
# CLOUD_RUN_EXECUTION is set; ignored otherwise.
# Defaults to '/mnt'
CAPTURES_DIR='/mnt'

# Slack webhook for run-summary notifications (reuses source/utils.py's
# notify_slack). Can be the same webhook the live pipeline uses, or a
# dedicated one for this job -- either way, set USE_SLACK: true in
# archive_backfill/config.yaml for this to take effect.
SLACK_WEBHOOK_URL=''
