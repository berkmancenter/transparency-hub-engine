# Do Not Put Sensitive Information Here
# Use .env instead
#

# Run in development mode, should NOT be set to true when hosted for production
# If set to 'true', the sync will save a json copy of the processed results and will not automatically delete the TEMP_DIR folder after running
# This allows you to inspect the results and retry the sync without running it again if it fails during the upload to the Mongo or GCP
# Defaults to false
DRY_RUN='false'

# Requires a Mongo Atlas Connection string, see the docs for more info
# https://www.mongodb.com/docs/atlas/driver-connection/?tck=docs_driver_python
# To run locally, use mongodb://localhost:27017/
# Defaults to 'mongodb://localhost:27017/'
MONGODB_URL='mongodb://localhost:27017/'

# Temporary directory that the program will use to manage files during the runtime
# DO NOT USE a directory that already exists unless DRY_RUN is set to 'true'
# During a prod run this directory is deleted at the end
# Defaults to 'tmp'
TEMP_DIR='tmp'

# The directory the Capture Engine will save processed files to locally
# Should be set to TEMP_DIR + "/docs" for local development with a GCP bucket
# Should not be set in TEMP_DIR if running without a GCP bucket
# Defaults to 'tmp/docs'
CAPTURES_DIR='tmp/docs'

# The directory within CAPTURES_DIR the Capture engine will save .CHANGES.json files
# Defaults to 'changes'
CHANGES_DIR='changes'

# Used in tandem with the PRIORITY_DICT declared in the config file
# Intended for use with an automatic scheduler, the Priority can be used to only capture a subset of companies
# Defaults to '1', which will run on all non-excluded companies in the input database
SYNC_PRIORITY = '1'

# The path to the config file
# Defaults to 'config.yaml'
CONFIG_PATH='config.yaml'

# The path to the directory that contains your Google Cloud Configuration variables
# This is only required when running the Engine in Docker locally
# For Windows users, the default location is ${APPDATA}/gcloud
# For Linux/MacOS users, the default location is ~/.config/gcloud
GCLOUD_CONFIG_DIR=${APPDATA}/gcloud

# Name of the Google Cloud Platform bucket the documents should be uploaded to
# Requires GCP Credentials to be set up in your environment
# Defaults to 'your_document_store', but should be declared unless you intend to keep the files local
GCP_BUCKET='your_document_store'
# Name of your Google Cloud Platform project
# Defaults to 'my-project-1234', but should be declared unless you intend to keep the files local
GCLOUD_PROJECT='my-project-1234'

# The Slack Webhook Url to send new document notifications to whenever the sync process detects a new version
# Check out the Slack docs for more information: https://docs.slack.dev/messaging/sending-messages-using-incoming-webhooks/
SLACK_WEBHOOK_URL=''